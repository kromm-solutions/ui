{
  "name": "kromm-ui-registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:all && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "registry:metadata": "jiti scripts/build-metadata.ts",
    "registry:build": "jiti scripts/build-registry.ts",
    "registry:verify": "jiti scripts/verify-registry.ts",
    "registry:all": "pnpm registry:metadata && pnpm registry:build && pnpm registry:verify",
    "postinstall": "fumadocs-mdx",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "lint:ds": "eslint registry registry-kromm-ui --no-config-lookup --config kromm-lint.config.mjs",
    "lint:ds:errors": "eslint registry registry-kromm-ui --no-config-lookup --config kromm-lint.config.mjs --quiet"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "1.11.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "postcss": "^8.5.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-aria-components": "^1.21.0",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ts-morph": "^26.0.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "shadcn": "4.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.1"
  },
  "description": "kromm ui — a shadcn-compatible component registry: headless UI primitives across Base UI, Radix and React Aria, build-time visual styles, and AI-agent tooling.",
  "homepage": "https://ui.kromm.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kromm-solutions/ui.git"
  },
  "bugs": "https://github.com/kromm-solutions/ui/issues"
}
