# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# generated content
.contentlayer
.content-collections
.source
# local tool binaries (antivirus-safe esbuild copy; keep out of git)
/.esb-copy/


# registry style-variant materialisations (scripts/build-registry.ts)
/.generated/

# registry distribution output (scripts/build-registry.ts → regenerated by pnpm registry:all / build)
/public/r/

# local agent memory (not project content)
/.agents/memory/

# OpenSpec artifacts (self-regenerated locally; fail CI lint scope if committed)
/OPENSPEC.md
/OPENSPEC.json
/test.json
/test-spec.json
/write-spec.js
/test-write.js
